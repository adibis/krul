# DV/UVM ontology — one example plugin contract for krul, not krul's own
# vocabulary. krul's core (schema/plugin_schema.json, src/c/validate.c)
# knows nothing about MODULE, UVM_AGENT, or DRIVES; it only knows how to
# load and check records against whichever ontology file a project's
# krul.toml points at. This is the ontology krul-indexer-codebert emits
# against — chip design verification's structural/verification/coverage/
# register partitioning of SystemVerilog and UVM.
#
# Format: one JSON object per line. entity_kind records pair a kind with
# the partition it belongs to; relation_kind records name a valid edge
# kind. Partition is itself ontology-defined — this file happens to use
# four, another ontology could use none or a dozen.
{"type":"entity_kind","kind":"MODULE","partition":"structural"}
{"type":"entity_kind","kind":"INTERFACE","partition":"structural"}
{"type":"entity_kind","kind":"PORT","partition":"structural"}
{"type":"entity_kind","kind":"MODPORT","partition":"structural"}
{"type":"entity_kind","kind":"PARAMETER","partition":"structural"}
{"type":"entity_kind","kind":"PACKAGE","partition":"structural"}
{"type":"entity_kind","kind":"CLOCK_DOMAIN","partition":"structural"}
{"type":"entity_kind","kind":"CLOCKING_BLOCK","partition":"structural"}
{"type":"entity_kind","kind":"UVM_TEST","partition":"verification"}
{"type":"entity_kind","kind":"UVM_ENV","partition":"verification"}
{"type":"entity_kind","kind":"UVM_AGENT","partition":"verification"}
