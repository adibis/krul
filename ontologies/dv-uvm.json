{"type":"entity_kind","kind":"FACTORY_OVERRIDE","partition":"verification"}
{"type":"entity_kind","kind":"UVM_EVENT","partition":"verification"}
{"type":"entity_kind","kind":"COVERGROUP","partition":"coverage"}
