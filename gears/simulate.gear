name: simulate
version: 2

triggers:
  - "run regression"
  - "run sim"
  - "run test"
  - "simulate"
  - "launch regression"
  - "run the"

stages:
  - id: decompose
    type: llm
    prompt: "Convert this simulation request into a shell command for VCS, Questa, or Xcelium. Output ONLY the shell command, no explanation.\n\nRequest: {input}"
  - id: execute
    type: process
    prompt: "echo 'Would run: {decompose}' && echo 'Simulation queued. Use kruld start to execute against your simulator.'"
  - id: analyze
    type: llm
    prompt: "Analyze this simulation result. Did it pass or fail? What are the key outcomes?\n\nCommand:\n{decompose}\n\nOutput:\n{execute}"

termination:
  condition: analyze.status == done
  max_iterations: 1
  on_max: return_last_analyze
